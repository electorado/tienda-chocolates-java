package clase0316CRUDDAO;

import clase0316CRUDDAO.org.example.dao.CursoDAO;
import clase0316CRUDDAO.org.example.model.Curso;

import java.util.List;
import java.util.Scanner;

//DAO significa Data Access Object, es un patrón de diseño.
// Su objetivo es separar la "lógica de negocio" (tu menú, tus cálculos) de la "lógica de acceso a datos" (el SQL).
public class Main {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);

        CursoDAO org.example.dao = new CursoDAO();

        int opcion;


        do {
            System.out.println("-------------LISTA DE OPCIONES---------------");
            System.out.println("1. Lista de cursos");
            System.out.println("2. Insertar cursos");
            System.out.println("3. Actualizar profesor");
            System.out.println("4. Eliminar cursos");
            System.out.println("5. Eliminar según créditos");
            System.out.println("0. salir");
            opcion = scanner.nextInt();
            scanner.nextLine();

            switch (opcion) {
                case 1:
                    List<Curso> cursos = org.example.dao.consultarCurso();
                    cursos.forEach(curso -> System.out.println(curso));
                    break;
                case 2:
                    System.out.println("Ingresa el nombre del curso");
                    String nombre = scanner.nextLine();
                    System.out.println("Ingresa el profesor del curso");
                    String profesor = scanner.nextLine();
                    System.out.println("Ingresa los créditos del curso");
                    int creditos = scanner.nextInt();

                    org.example.dao.insertarCurso(new Curso(nombre, profesor, creditos));
                    break;
                case 3:
                    System.out.println("Ingresa ID curso: ");
                    int id = scanner.nextInt();
                    scanner.nextLine();

                    System.out.println("Nuevo nombre del profesor");
                    String nombreProfesor = scanner.nextLine();

                    org.example.dao.actualizarProfesor(id, nombreProfesor);
                    break;
                case 4:
                    System.out.println("Ingresa el ID del curso a eliminar: ");
                    int eliminar = scanner.nextInt();
                    org.example.dao.eliminarCurso(eliminar);
                    break;
                case 5:
                    System.out.println("Ingresa el curso a eliminar: ");
                    int eliminarCurso = scanner.nextInt();
                    org.example.dao.eliminarCursoSegunCreditos(eliminarCurso);
                    break;
            }
        }while (opcion != 0);

        scanner.close();
    }
}

